  "parentCard": {
    "title": "The tower of ten and the little tower",
    "minutes": 15,
    "includes": "blocks",
    "steps": [
      "Build one tower of exactly ten blocks together, counting each block out loud as it goes on.",
      "Stand that tower on the table and say: this one is our ten. Then build a little tower of three beside it.",
      "Ask them which tower is the ten, and let them point. If they point at the little one, do not correct it, just count both towers again together and ask again.",
      "Say the number the two towers make: ten and three, thirteen. Then take one block off the little tower and say it again: ten and two, twelve.",
      "Let them choose how tall the little tower is, and let them say the number, with you saying the first half and them landing the second."
    ],
    "notice": [
      "Do they count all ten blocks with one number for one block, without skipping or doubling back?",
      "Do they point at the tall tower when you ask which one is the ten?",
      "Do they ever say the two part name, ten and something, without you starting it?"
    ]
  }
