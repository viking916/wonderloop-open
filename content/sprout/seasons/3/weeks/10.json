  "parentCard": {
    "title": "The rhyme they land",
    "minutes": 15,
    "includes": "read-aloud",
    "steps": [
      "Choose a rhyming book you have both read enough times that they half know it. Sit where they can see the pictures.",
      "Read a page at your normal speed, then read the next one and stop just before the rhyming word. Wait. Do not fill the gap for them.",
      "If nothing comes, say the line again from the start and land on the first sound of the missing word, then wait again.",
      "When they land one, say the two rhyming words back to back so they hear the echo: moon, spoon.",
      "At the end, make up one silly rhyme together for their own name, and let their version be the one you both say twice."
    ],
    "notice": [
      "Do they come in on the rhyme by themselves, or only when you give them the first sound?",
      "Do they hear the echo in two words that rhyme, or are they going by the picture on the page?",
      "When they make up a rhyme of their own, does it really rhyme, even if the word is nonsense?"
    ]
  }
