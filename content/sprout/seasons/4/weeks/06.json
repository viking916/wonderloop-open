  "parentCard": {
    "title": "The make-ten tower game",
    "minutes": 15,
    "includes": "blocks",
    "steps": [
      "Count out exactly ten blocks together, out loud, and stand them up as one tower. Say ten, then knock it over on purpose, because that is the good part.",
      "Build a tower of six and push it across to their side of the table. Ask them for the tower that finishes the ten, and let them build it block by block, counting out loud, however slowly they want.",
      "Stand the two towers side by side and count the whole thing from the bottom, one to ten. Then say the pair together out loud: six and four make ten.",
      "Swap chairs. They build the first tower and you build the partner, and every so often build yours wrong on purpose so that they get to be the one who catches it.",
      "Finish on hands. Put six fingers up, ask them for the rest, and count all ten fingers together. Tell them the partner was hiding in their hands the whole time."
    ],
    "notice": [
      "When they build the partner tower, do they count on from six, or do they go back and start again at one?",
      "Do they reach for their fingers by themselves, or do they wait to be told that fingers are allowed?",
      "When you build it wrong on purpose, do they catch it by counting the blocks or by looking at the height?"
    ]
  }
