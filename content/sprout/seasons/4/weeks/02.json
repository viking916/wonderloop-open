  "parentCard": {
    "title": "The counting book, done on fingers",
    "minutes": 15,
    "includes": "read-aloud",
    "steps": [
      "Pick a counting storybook off the shelf, one with a number on nearly every page, and read it aloud together.",
      "Every time the story joins two amounts, stop reading and act it on fingers. Put the bigger number up first and hold that hand still.",
      "Let them count the smaller amount on, one finger at a time, saying the numbers out loud starting from the big one.",
      "Once in the middle of the book, put the smaller number up first on purpose. Ask them which way was quicker and let them tell you.",
      "At the end, let them tell one page back to you as their own joining story, with toys instead of the book."
    ],
    "notice": [
      "Do they start from the bigger number without being told which one it is?",
      "Do they count on from the big number, or do they go all the way back to one first?",
      "Do they say the numbers out loud as the fingers go up, or count silently and lose their place?"
    ]
  }
