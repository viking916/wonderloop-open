  "parentCard": {
    "title": "Kitchen-band pattern jam",
    "minutes": 15,
    "includes": "sing",
    "steps": [
      "Set up the kitchen band together: hands to clap, feet to stomp, and a spoon on a pot for the ding.",
      "Sing and play a three-part pattern together: clap, stomp, ding, clap, stomp, ding.",
      "Make them the band leader: they play a pattern and you copy it exactly, silly mistakes and all.",
      "Make your next pattern one sound longer and see if they can play it back."
    ],
    "notice": [
      "Do they keep all three sounds in their order, or do two of them swap places?",
      "When they lead, do they invent a pattern that uses three different sounds on their own?"
    ]
  }
