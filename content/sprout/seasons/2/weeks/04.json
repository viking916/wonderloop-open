  "parentCard": {
    "title": "The sound walk",
    "minutes": 15,
    "includes": "why-walk",
    "steps": [
      "Step outside together and announce the hunt: today we listen for sss.",
      "Hunt three things whose names start with sss, like sun, sky, sand or stones. Say each name slowly together and stretch the sss.",
      "Ask one why question about each find, like why is the sun warm, or why do stones sit so still, and wonder about the answers together.",
      "On the way home, hunt one last sound: the first sound of their own name."
    ],
    "notice": [
      "Do they start stretching first sounds on their own, without being asked?",
      "Which is easier for them: hearing sss at the front of a word you say, or finding a new sss word themselves?"
    ]
  }
