  "parentCard": {
    "title": "The counting song",
    "minutes": 15,
    "includes": "sing",
    "steps": [
      "Pick a song they already know and love, and sing it together once just for fun.",
      "Sing it again and clap the beat together, counting the claps out loud up to 8, then starting again at 1.",
      "Swap jobs: they clap and lead the counting for a verse while you follow, then trade back.",
      "When it feels easy, count wrong on purpose once, skipping 6, and see if they catch you.",
      "Try one verse with eyes closed, counting the claps by ear only."
    ],
    "notice": [
      "Do they keep one number for one clap all the way to 8, or do the numbers race ahead of their hands?",
      "Did they catch the skipped 6, and did it make them laugh?",
      "Can they still count the claps with their eyes closed, ears only?"
    ]
  }
