  "parentCard": {
    "title": "The staircase count",
    "minutes": 15,
    "includes": "why-walk",
    "steps": [
      "Head out for a short walk and hunt for steps together: stairs, curbs, big flat stones.",
      "Climb them slowly and count out loud together, one number for one step, never two.",
      "Find a longer staircase and see if the count can climb all the way to 7. If it wobbles, climb slower, not lower.",
      "On the way home, let them pick one thing you passed and wonder why together, like why do stairs come in steps instead of one big jump? No right answer needed."
    ],
    "notice": [
      "Do they say exactly one number for each step, or do their feet run ahead of their numbers?",
      "How high do they count before it wobbles?",
      "Did they ask a why question of their own on the walk?"
    ]
  }
