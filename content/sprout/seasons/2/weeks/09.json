  "parentCard": {
    "title": "Hopscotch to 10",
    "minutes": 15,
    "includes": "cut-draw",
    "steps": [
      "Take chalk outside and draw a hopscotch ladder of ten squares together, taking turns: they draw some squares, you draw some, and say each number out loud as its square appears.",
      "Hop the ladder together, one number for one square, all the way to 10. Feet are best, but finger-hopping the squares counts too if legs get tired.",
      "Toss a pebble onto a square, hop to it, and say the number it landed on. Swap: they toss, you hop, and they check your counting.",
      "Let them decorate their favorite square with a chalk drawing of anything they love."
    ],
    "notice": [
      "Do they say exactly one number for one hop, or do their feet run ahead of their numbers past 8?",
      "Where does the count wobble first: 7, 8, or 9?",
      "Did they go back to the hopscotch ladder on their own afterwards?"
    ]
  }
}
