  "parentCard": {
    "title": "Build a tower",
    "minutes": 15,
    "includes": "blocks",
    "steps": [
      "Build a tower of blocks together, one block at a time.",
      "Ask them to count how many blocks are in the tower.",
      "Knock it down and build a shorter tower next to it.",
      "Ask them which tower is taller and which one has more blocks.",
      "Prop a block against a book to make a ramp. Find a ball or a round toy. Ask them to guess which rolls farther, the ball or a block, then let them try."
    ],
    "notice": [
      "Do they recount the blocks from one each time, or remember the total?",
      "When you ask which tower has more, do they point straight at the taller one, or do they count to check?",
      "Do they guess before they roll, or only decide after watching it happen?"
    ]
  }
