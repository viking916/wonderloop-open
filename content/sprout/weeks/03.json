  "parentCard": {
    "title": "Kind and size walk",
    "minutes": 15,
    "includes": "why-walk",
    "steps": [
      "Take them on a short walk around the house or outside.",
      "Ask them to find three things that are the same kind, like three leaves or three rocks.",
      "Ask them which one is the biggest and which one is the smallest.",
      "Bring them inside and sort them again on the floor."
    ],
    "notice": [
      "Do they pick three of the same kind without help?",
      "Do they compare sizes using words like big, middle, small?"
    ]
  }
