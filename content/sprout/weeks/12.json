  "parentCard": {
    "title": "Sing to three, celebrate the season",
    "minutes": 15,
    "includes": "sing",
    "steps": [
      "Sing a short counting song together, like one two buckle my shoe, just the first three lines.",
      "Hold up a finger for each number as you sing, and ask them to hold up their own fingers too.",
      "After the song, ask them to count something in the room out loud, up to three.",
      "This week, hand this card to an older sibling, or a grown-up: let them run today's counting song and celebrate the season together.",
      "Talk together about the season: patterns, sorting, counting and stories. Ask them to show one thing they can do now."
    ],
    "notice": [
      "Do they keep the right number of fingers up as they sing, or lose count partway?",
      "Does the older sibling or grown-up notice something new they can do that they could not do before?"
    ]
  }
