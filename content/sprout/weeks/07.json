  "parentCard": {
    "title": "Tell the story",
    "minutes": 15,
    "includes": "read-aloud",
    "steps": [
      "Pick a short picture book you both know well.",
      "Read through it together once, start to finish.",
      "Ask them to retell what happened using first, then and next.",
      "Let them use their own words. Do not correct the order if they mix a small detail."
    ],
    "notice": [
      "Do they use the words first, then and next on their own?",
      "Do they leave out a part of the story or add one that was not there?"
    ]
  }
