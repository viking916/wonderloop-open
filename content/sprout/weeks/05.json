  "parentCard": {
    "title": "Cut and count shapes",
    "minutes": 15,
    "includes": "cut-draw",
    "steps": [
      "Draw four or five simple shapes on paper, like circles or stars.",
      "Cut them out yourself while they watch, so the scissors stay in your hands.",
      "Ask them to count the cutouts out loud as they line them up.",
      "Draw a second, smaller group of shapes and ask them which group has more."
    ],
    "notice": [
      "Do they count each cutout only once, touching it as they say the number?",
      "Do they compare the two groups by counting, or just by looking at the piles?"
    ]
  }
