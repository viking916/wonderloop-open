  "parentCard": {
    "title": "Find the matching pair",
    "minutes": 15,
    "includes": "cut-draw",
    "steps": [
      "Draw two matching shapes on paper, like two red circles, exactly the same colour and shape.",
      "Draw one more shape that does not match, like a blue circle or a red square.",
      "Cut out the three shapes yourself, or let them help if scissors are already easy for them.",
      "Mix up the three shapes and ask them to find the two that match.",
      "Ask them to tell you what makes the two shapes match."
    ],
    "notice": [
      "Can they find the matching pair by looking, without you naming the colour or shape first?",
      "Can they say what makes the two shapes match, in their own words?"
    ]
