{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9390
    },
    "firestore": {
      "port": 8380
    },
    "storage": {
      "port": 9490
    },
    "ui": {
      "enabled": true,
      "port": 4300
    },
    "hub": {
      "port": 4390
    },
    "logging": {
      "port": 4490
    }
  },
  "hosting": {
    "source": "web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "frameworksBackend": {
      "region": "us-central1",
      "secrets": [
        "AI_KEY_SECRET"
      ]
    }
  }
}
