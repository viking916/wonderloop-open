{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "prebuild": "npm run validate:content && npm run generate:content",
    "start": "next start",
    "lint": "eslint",
    "pretypecheck": "npm run generate:content",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run generate:content",
    "test": "vitest run",
    "test:rules": "vitest run --config vitest.emulator.config.ts",
    "test:watch": "vitest",
    "validate:content": "tsx scripts/validate-content.ts ../content",
    "validate:content:partial": "tsx scripts/validate-content.ts ../content --partial",
    "content:report": "tsx scripts/content-report.ts ../content",
    "generate:content": "tsx scripts/generate-content.ts ../content",
    "emulators": "cd .. && firebase emulators:start --only auth,firestore,storage --project wonderloop-dev",
    "seed": "tsx --env-file=.env.development.local scripts/seed-emulators.ts",
    "verify:ui": "node --env-file=.env.development.local scripts/verify-ui.mjs",
    "bootstrap:prod": "tsx scripts/bootstrap-household.ts",
    "allowlist": "tsx scripts/allowlist.ts",
    "postbuild": "node scripts/check-externals.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "@types/three": "^0.170.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "firebase-admin-a14c8a5423a75469": "npm:firebase-admin@^14.3.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "three": "^0.170.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "firebase-tools": "^13.35.1",
    "jsdom": "^25.0.1",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22"
  }
}
