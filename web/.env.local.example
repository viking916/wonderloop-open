# Copy to web/.env.development.local (emulators) or web/.env.production.local (a real project).
# Both are git-ignored. docs/DEPLOYMENT.md explains every way to run the app.

# --- Firebase client SDK (Project settings > General > Your apps). Identifiers, not secrets:
# the security rules are the real gate. Leave blank to run against the local emulators.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# "true" points the browser at the local emulator suite (ports in lib/firebase/emulator-ports.mjs).
NEXT_PUBLIC_USE_EMULATORS=false
# Where the browser reaches the emulators; localhost unless they run on another machine.
NEXT_PUBLIC_EMULATOR_HOST=localhost

# --- Server side (the app's own API routes and the admin scripts).
# The project the Admin SDK talks to. Unset when the emulators are in use.
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
# Emulator hosts for the SERVER (set by the docker-compose file; leave unset otherwise):
# FIRESTORE_EMULATOR_HOST=localhost:8380
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9390
# FIREBASE_STORAGE_EMULATOR_HOST=localhost:9490
# Credentials for a real project when NOT running on Firebase Hosting or Cloud Run: the service
# account key as raw JSON or base64 (Project settings > Service accounts > Generate new key).
FIREBASE_SERVICE_ACCOUNT_JSON=
# Or a path to that key file instead:
# GOOGLE_APPLICATION_CREDENTIALS=

# Encrypts each family's stored Anthropic key (lib/ai/keys.ts). Any long random string; once
# chosen, never change it, or every stored key becomes unreadable. Generate one with
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AI_KEY_SECRET=

# Only for scripts/debate-screenshots.mjs and scripts/ai-key.ts: families supply their own key
# in the Parent view, the app itself never reads this.
ANTHROPIC_API_KEY=

# Set by the Dockerfile; leave unset for Firebase Hosting.
# NEXT_OUTPUT=standalone
