# firebase-frameworks (the Firebase Hosting Next.js adapter) declares a peer of
# firebase-admin ^11 || ^12 || ^13, and this project is on 14. The conflict is benign here:
# firebase-admin is used only by our own scripts (seed, bootstrap, allowlist, rules tests),
# never by the deployed app, which talks to Firebase through the client SDK. Without this the
# adapter's install step during `firebase deploy` fails with ERESOLVE.
legacy-peer-deps=true
